@page
@model FlowerShop.Web.Pages.Account.ResetPasswordModel

@section Styles {
    <link rel="stylesheet" href="/css/authorization.css" asp-append-version="true" />
}

<div class="auth-center">
    <div class="form-card">
        <span class="hero-badge">
            <img src="/img/star-icon-authorization.png" />
        </span>

        @if (!Model.TokenValid)
        {
            <h2>Ссылка недействительна</h2>
            <p class="subtitle">Ссылка для сброса устарела или уже использована.</p>
            <a href="/Account/ForgotPassword" class="submit-btn" style="display:block;text-align:center;text-decoration:none;margin-top:16px;">
                Запросить новую ссылку
            </a>
        }
        else
        {
            <h2>Новый пароль</h2>
            <p class="subtitle">Придумайте надёжный пароль</p>

            <form method="post">
                <div asp-validation-summary="ModelOnly" class="error"></div>
                <input type="hidden" asp-for="Token" />

                <div class="form-group">
                    <label asp-for="NewPassword"></label>
                    <input asp-for="NewPassword" class="form-control" type="password" placeholder="Минимум 6 символов" />
                    <span asp-validation-for="NewPassword" class="text-danger"></span>
                </div>

                <div class="form-group">
                    <label asp-for="ConfirmPassword"></label>
                    <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Повторите пароль" />
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>

                <button type="submit" class="submit-btn">Сохранить пароль</button>
            </form>
        }
    </div>
</div>
