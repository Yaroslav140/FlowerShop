@page
@model FlowerShop.Web.Pages.Account.ForgotPasswordModel

@section Styles {
    <link rel="stylesheet" href="/css/authorization.css" asp-append-version="true" />
}

<div class="auth-center">
    <div class="form-card">
        <span class="hero-badge">
            <img src="/img/star-icon-authorization.png" />
        </span>
        <h2>Сброс пароля</h2>
        <p class="subtitle">Введите email — отправим ссылку для сброса</p>

        @if (Model.Sent)
        {
            <div style="background:#e8f5e9;border-radius:8px;padding:16px;text-align:center;color:#2e7d32;margin-bottom:16px;">
                Письмо отправлено! Проверьте почту.
            </div>
        }

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="error"></div>
            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>
            <button type="submit" class="submit-btn">Отправить ссылку</button>
        </form>

        <div class="signin" style="margin-top:16px;">
            <a href="/Account/Login">Вернуться ко входу</a>
        </div>
    </div>
</div>
