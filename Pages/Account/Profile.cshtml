@page
@model FlowerShop.Web.Pages.Account.ProfileModel

@section Styles{
    <link rel="stylesheet" href="/css/profile.css" asp-append-version="true"/>
}

<div class="profile-page">
    <h1 class="profile-title">Мой профиль</h1>
    <p class="profile-subtitle">Управляйте своим профилем и заказами</p>

    <div class="profile-card">

        <div class="profile-header">
            <span class="profile-avatar">
                <img src="@Url.Content("~/img/user.png")" alt="Аватар пользователя" />
            </span>
            <h2 class="profile-name">@Model.Username</h2>
            <p class="profile-login">@("@")@Model.Login</p>
        </div>

        <div class="profile-stats">
            <div class="stat-item">
                <span class="stat-label">Дата регистрации</span>
                <span class="stat-value">@Model.DateRegister.ToShortDateString()</span>
            </div>
            <div class="stat-item">
                <span class="stat-label">Заказов выполнено</span>
                <span class="stat-value">@Model.CountOrderCompleted</span>
            </div>
        </div>

        <div class="profile-actions">
            <a asp-action="EditProfile" asp-controller="Account" class="btn btn-primary">
                <img src="/img/icons/edit.svg" alt="" class="btn-icon" />
                Редактировать профиль
            </a>

            <form method="post" asp-action="DeleteProfile" asp-controller="Account">
                <button type="submit" class="btn btn-danger" onclick="return confirm('Вы уверены, что хотите удалить профиль?');">
                    <img src="/img/icons/trash.svg" alt="" class="btn-icon" />
                    Удалить профиль
                </button>
            </form>
        </div>
    </div>
</div>
