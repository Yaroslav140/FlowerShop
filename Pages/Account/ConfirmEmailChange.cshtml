@page
@model FlowerShop.Web.Pages.Account.ConfirmEmailChangeModel

@section Styles {
    <link rel="stylesheet" href="/css/authorization.css" asp-append-version="true" />
}

<div class="auth-center">
    <div class="form-card">
        <span class="hero-badge">
            <img src="/img/star-icon-authorization.png" />
        </span>

        @if (Model.Success)
        {
            <h2>Email изменён!</h2>
            <p class="subtitle">Ваш новый email подтверждён. Войдите с новым адресом.</p>
            <a href="/Account/Login" class="submit-btn" style="display:block;text-align:center;text-decoration:none;margin-top:16px;">
                Войти
            </a>
        }
        else
        {
            <h2>Ошибка</h2>
            <p class="subtitle">@Model.ErrorMessage</p>
            <a href="/Account/Profile" class="submit-btn" style="display:block;text-align:center;text-decoration:none;margin-top:16px;">
                Вернуться в профиль
            </a>
        }
    </div>
</div>
