@page
@model FlowerShop.Web.Pages.Account.RegisterModel

@section Styles {
    <link rel="stylesheet" href="~/css/authorization.css" asp-append-version="true" />
}

<div class="auth-center">
    <div class="form-card">
        <span class="hero-badge">
            <img src="/img/star-icon-authorization.png" />
        </span>
        <h2>Создание аккаунта</h2>
        <p class="subtitle">Присоединяйтесь к нам, чтобы начать заказывать<br /> красивые цветы</p>

        <form method="post">
            <div asp-validation-summary="ModelOnly" class="alert error"></div>

            <div class="form-group">
                <label asp-for="UserName"></label>
                <input asp-for="UserName" class="form-control" placeholder="Введите имя пользователя" />
                <span asp-validation-for="UserName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Email"></label>
                <input asp-for="Email" class="form-control" type="email" placeholder="example@mail.ru" />
                <span asp-validation-for="Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Password"></label>
                <input asp-for="Password" class="form-control" type="password" placeholder="Введите пароль" />
                <input type="text" name="WebSite" id="WebSite" tabindex="-1" autocomplete="off" style="position: absolute; left: -9999px; opacity: 0;" placeholder="Website" />
                <span asp-validation-for="Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="ConfirmPassword"></label>
                <input asp-for="ConfirmPassword" class="form-control" type="password" placeholder="Повторите пароль" />
                <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
            </div>

            <div class="form-group" style="display:flex; align-items:flex-start; gap:10px; margin-top:8px;">
                <input asp-for="ConsentPersonalData" type="checkbox" id="consent" style="margin-top:3px; flex-shrink:0;" />
                <label for="consent" style="font-size:0.9rem; line-height:1.4; cursor:pointer;">
                    Я согласен(на) с
                    <a href="/PrivacyPolicy" target="_blank" rel="noopener">обработкой персональных данных</a>
                </label>
            </div>
            <span asp-validation-for="ConsentPersonalData" class="text-danger" style="display:block; margin-top:4px;"></span>

            <button type="submit" class="submit-btn" style="margin-top:16px;">Зарегистрироваться</button>
        </form>

        <div class="signin">
            У вас уже есть учетная запись? <a href="/Account/Login">Войти</a>
        </div>
    </div>
</div>
